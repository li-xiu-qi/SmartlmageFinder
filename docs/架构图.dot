digraph SmartImager {
  graph [rankdir=TB, splines=polyline, nodesep=0.35, ranksep=0.55,
         bgcolor="white", fontname="Microsoft YaHei", pad=0.3];
  node  [fontname="Microsoft YaHei", fontsize=12, shape=box, style="rounded,filled",
         color="#c8cdd4", penwidth=1.1, margin="0.16,0.10"];
  edge  [fontname="Microsoft YaHei", fontsize=10, color="#8a929c", penwidth=1.1, arrowsize=0.7];

  // ── 用户 ──
  user [label="用户（浏览器）", shape=oval, fillcolor="#f4f5f7", color="#b8bec7"];

  // ── 节点一：Next.js 全栈（本机:3000）──
  subgraph cluster_next {
    label="Next.js 全栈  本机 :3000";
    fontsize=13; fontname="Microsoft YaHei"; fontcolor="#3a4656";
    style="rounded,filled"; fillcolor="#f7f9fc"; color="#c3ccd8"; penwidth=1.2;
    margin=14;

    fe [label="前端 7 页面\n首页 / 图片库 / 上传 / 搜索\n标签 / 设置 / 404\nReact 18 + shadcn/ui + Tailwind",
        fillcolor="#e8eef6", color="#a9bdd6"];
    api [label="业务 API  Route Handlers\n/api/v1/images · tags · search · system\n/api/v1/ai/conversations · recommend",
        fillcolor="#e8eef6", color="#a9bdd6"];
    db [label="本地 SQLite\nbetter-sqlite3\n图片元数据 · 会话 · 标签",
        fillcolor="#f0f2f5", color="#c0c6cf"];
  }

  // ── 节点二：Python 推理服务（dgx-spark:8100）──
  subgraph cluster_inf {
    label="Python 推理服务  远程 dgx-spark :8100";
    fontsize=13; fontname="Microsoft YaHei"; fontcolor="#3a4656";
    style="rounded,filled"; fillcolor="#f6faf7"; color="#c2d6c9"; penwidth=1.2;
    margin=14;

    enc [label="向量编码  /encode\njina-embeddings-v4（2048 维）\n文本 / 图片多模态",
         fillcolor="#e6f0ea", color="#a8c8b6"];
    vec [label="向量检索  /vectors/*\nsqlite-vec\n标题 / 描述 / 图片内容",
         fillcolor="#e6f0ea", color="#a8c8b6"];
    vis [label="图像分析  /analyze\nglm-4.6v-flash\n自动生成标题 / 描述 / 标签",
         fillcolor="#e6f0ea", color="#a8c8b6"];
  }

  // ── 数据流 ──
  user -> fe [label="  HTTP"];
  fe -> api;
  api -> db [label="  读写"];
  api -> enc [label="  HTTP  编码请求", constraint=true];
  api -> vec [label="  HTTP  向量检索"];
  api -> vis [label="  HTTP  上传分析"];
}
